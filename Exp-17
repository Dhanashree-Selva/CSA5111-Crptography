#include <stdio.h>

#include <stdint.h>

 

/* Demonstrates the required reverse order of round keys. */

int main(void) {

    uint64_t round_key[16];

    int i;

 

    /* Placeholder round-key values; normally produced by DES PC-1,

       left rotations, and PC-2 from a 64-bit DES key. */

    for (i = 0; i < 16; i++)

        round_key[i] = (uint64_t)(i + 1);

 

    printf("DES decryption round-key order:\n");

    for (i = 15; i >= 0; i--)

        printf("Round %2d uses K%-2d\n", 16 - i, i + 1);

 

    return 0;

}
