
#include <stdio.h>

int main(void) {
    int K[2][2] = {{9, 4}, {5, 7}}; /* Secret key for demonstration */
    int P[2][2] = {{1, 0}, {0, 1}};
    int C[2][2];
    int i, j, k;

    printf("Chosen plaintext pairs: BA and AB\n");

    /* Simulate encryption oracle */
    for (j = 0; j < 2; j++) {
        for (i = 0; i < 2; i++) {
            C[i][j] = 0;
            for (k = 0; k < 2; k++)
                C[i][j] += K[i][k] * P[k][j];

            C[i][j] %= 26;
        }
    }

    printf("Ciphertext of BA: %c%c\n",
           C[0][0] + 'A', C[1][0] + 'A');
    printf("Ciphertext of AB: %c%c\n",
           C[0][1] + 'A', C[1][1] + 'A');

    printf("Recovered key matrix:\n");
    for (i = 0; i < 2; i++)
        printf("%d %d\n", C[i][0], C[i][1]);

    return 0;
}
