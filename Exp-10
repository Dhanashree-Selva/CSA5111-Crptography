#include <stdio.h>
#include <string.h>
#include <ctype.h>

char mat[5][5] = {
    {'M','F','H','I','K'},
    {'U','N','O','P','Q'},
    {'Z','V','W','X','Y'},
    {'E','L','A','R','G'},
    {'D','S','T','B','C'}
};

void pos(char ch, int *r, int *c) {
    int i,j;
    if (ch=='J') ch='I';
    for(i=0;i<5;i++) for(j=0;j<5;j++)
        if(mat[i][j]==ch) {*r=i;*c=j;return;}
}

int main(void) {
    char text[500], p[500], out[500];
    int i,n=0,m=0,r1,c1,r2,c2;
    printf("Enter plaintext: ");
    fgets(text,sizeof(text),stdin);

    for(i=0;text[i]!='\0';i++) {
        if(isalpha((unsigned char)text[i])) {
            char ch=toupper((unsigned char)text[i]);
            if(ch=='J') ch='I';
            p[n++]=ch;
        }
    }

    /* Prepare digraphs, inserting X between repeated letters. */
    for(i=0;i<n;) {
        char a=p[i++], b;
        if(i==n) b='X';
        else if(p[i]==a) b='X';
        else b=p[i++];

        pos(a,&r1,&c1); pos(b,&r2,&c2);
        if(r1==r2) {
            out[m++]=mat[r1][(c1+1)%5];
            out[m++]=mat[r2][(c2+1)%5];
        } else if(c1==c2) {
            out[m++]=mat[(r1+1)%5][c1];
            out[m++]=mat[(r2+1)%5][c2];
        } else {
            out[m++]=mat[r1][c2];
            out[m++]=mat[r2][c1];
        }
    }
    out[m]='\0';
    printf("Ciphertext: %s\n",out);
    return 0;
}

