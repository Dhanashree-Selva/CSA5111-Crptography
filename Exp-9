#include <stdio.h>
#include <string.h>
#include <ctype.h>

char mat[5][5];

void makeMatrix(char key[]) {
    int used[26] = {0}, r=0, c=0, i;
    char ch;
    used['J'-'A'] = 1;
    for (i=0; i<(int)strlen(key)+26; i++) {
        if (i < (int)strlen(key)) ch=toupper((unsigned char)key[i]);
        else ch='A'+i-(int)strlen(key);
        if (ch<'A' || ch>'Z') continue;
        if (ch=='J') ch='I';
        if (!used[ch-'A']) {
            mat[r][c++]=ch; used[ch-'A']=1;
            if (c==5) { c=0; r++; }
            if (r==5) break;
        }
    }
}
void pos(char ch, int *r, int *c) {
    int i,j; if (ch=='J') ch='I';
    for(i=0;i<5;i++) for(j=0;j<5;j++)
        if(mat[i][j]==ch) {*r=i;*c=j;return;}
}
int main(void) {
    char key[100], ct[1000], out[1000];
    int i,n=0,m=0,r1,c1,r2,c2;
    printf("Enter Playfair keyword: ");
    scanf("%99s",key); getchar();
    printf("Enter ciphertext (letters in pairs): ");
    fgets(ct,sizeof(ct),stdin);
    makeMatrix(key);
    for(i=0;ct[i]!='\0';i++)
        if(isalpha((unsigned char)ct[i])) out[n++]=toupper((unsigned char)ct[i]);
    out[n]='\0';

    for(i=0;i+1<n;i+=2) {
        pos(out[i],&r1,&c1); pos(out[i+1],&r2,&c2);
        if(r1==r2) {
            out[m++]=mat[r1][(c1+4)%5];
            out[m++]=mat[r2][(c2+4)%5];
        } else if(c1==c2) {
            out[m++]=mat[(r1+4)%5][c1];
            out[m++]=mat[(r2+4)%5][c2];
        } else {
            out[m++]=mat[r1][c2];
            out[m++]=mat[r2][c1];
        }
    }
    out[m]='\0';
    printf("Decrypted text: %s\n",out);
    return 0;
}

