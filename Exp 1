#include <stdio.h>
#include <string.h>
#include <ctype.h>

void encrypt(char text[], int k) {
    for (int i = 0; text[i] != '\0'; i++) {
        if (isupper(text[i]))
            text[i] = (text[i] - 'A' + k) % 26 + 'A';
        else if (islower(text[i]))
            text[i] = (text[i] - 'a' + k) % 26 + 'a';
    }
}

void decrypt(char text[], int k) {
    for (int i = 0; text[i] != '\0'; i++) {
        if (isupper(text[i]))
            text[i] = (text[i] - 'A' - k + 26) % 26 + 'A';
        else if (islower(text[i]))
            text[i] = (text[i] - 'a' - k + 26) % 26 + 'a';
    }
}

int main() {
    char text[100];
    int k;

    printf("Enter plaintext: ");
    fgets(text, sizeof(text), stdin);

    printf("Enter key (1-25): ");
    scanf("%d", &k);

    if (k < 1 || k > 25) {
        printf("Invalid key. Enter a value from 1 to 25.\n");
        return 0;
    }

    encrypt(text, k);
    printf("Encrypted text: %s", text);

    decrypt(text, k);
    printf("Decrypted text: %s", text);

    return 0;
}
